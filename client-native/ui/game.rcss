/* ============================================================
   OSRS Prototype — Game UI Stylesheet
   Authentic OSRS-inspired dark brown/gold colour palette.
   Uses RmlUi-compatible RCSS (no border shorthand with style,
   no text-shadow, no box-shadow, no cursor property).
   ============================================================ */

body {
  font-family: Segoe UI;
  font-size: 13dp;
  color: #ffffff;
}

/* ---- Right-side HUD container ---- */

#hud-container {
  position: fixed;
  top: 0dp;
  right: 0dp;
  width: 220dp;
  height: 100%;
  display: flex;
  flex-direction: column;
}

#tab-bar {
  display: flex;
  flex-direction: row;
  background-color: #1a0d00;
  border-bottom-width: 1dp;
  border-bottom-color: #3d2010;
  padding: 4dp 2dp;
  gap: 2dp;
  flex-shrink: 0;
}

.tab-btn {
  flex: 1;
  padding: 6dp 4dp;
  text-align: center;
  font-size: 11dp;
  font-weight: bold;
  color: #c8a060;
  background-color: #0d0600;
  border-width: 1dp;
  border-color: #3d2010;
  border-radius: 2dp;
}

.tab-btn:hover {
  background-color: #2a1508;
  border-color: #5a3020;
}

.tab-btn.active {
  background-color: #3d2010;
  border-color: #ff981f;
  color: #ff981f;
}

#tab-content {
  flex: 1;
  overflow-y: auto;
  background-color: rgba(10, 4, 0, 0.92);
  border-left-width: 1dp;
  border-left-color: rgba(61, 32, 16, 0.70);
}

/* Hide all panels by default; show active */
.tab-panel {
  display: none;
  padding: 6dp;
}

.tab-panel.active {
  display: block;
}

/* ---- Inventory Panel ---- */

#inventory-grid {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: 3dp;
  justify-content: center;
}

.inv-slot {
  width: 48dp;
  height: 48dp;
  background-color: rgba(13, 6, 0, 0.70);
  border-width: 1dp;
  border-color: rgba(61, 32, 16, 0.55);
  border-radius: 2dp;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  position: relative;
}

.inv-slot:hover {
  border-color: #ff981f;
}

.inv-slot.filled {
  background-color: rgba(26, 13, 0, 0.85);
}

.inv-slot .item-name {
  font-size: 9dp;
  color: #dcc878;
  text-align: center;
  overflow: hidden;
  padding: 2dp;
}

.inv-slot .item-qty {
  position: absolute;
  bottom: 1dp;
  right: 3dp;
  font-size: 8dp;
  font-weight: bold;
  color: #ffdd44;
}

/* ---- Skills Panel ---- */

#skills-grid {
  display: flex;
  flex-direction: column;
  gap: 3dp;
}

.skill-card {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 6dp;
  padding: 4dp 6dp;
  background-color: rgba(13, 6, 0, 0.28);
  border-width: 1dp;
  border-color: #3d2010;
  border-radius: 2dp;
}

.skill-card:hover {
  border-color: #5a3020;
  background-color: rgba(26, 13, 0, 0.45);
}

.skill-name {
  flex: 1;
  font-size: 10dp;
  color: #c8a060;
}

.skill-level {
  font-size: 14dp;
  font-weight: bold;
  color: #ffcc44;
  min-width: 28dp;
  text-align: right;
}

.skill-xp {
  font-size: 9dp;
  color: #8b6c3e;
  min-width: 60dp;
  text-align: right;
}

#skills-total {
  margin-top: 6dp;
  padding: 4dp 6dp;
  font-size: 11dp;
  font-weight: bold;
  color: #ff981f;
  text-align: center;
  border-top-width: 1dp;
  border-top-color: rgba(61, 32, 16, 0.60);
}

/* ---- Equipment Panel ---- */

#equipment-grid {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 3dp;
  padding: 8dp 4dp;
}

.equip-row {
  display: flex;
  flex-direction: row;
  gap: 3dp;
}

.equip-slot {
  width: 56dp;
  height: 56dp;
  background-color: rgba(10, 4, 0, 0.45);
  border-width: 1dp;
  border-color: rgba(61, 32, 16, 0.70);
  border-radius: 2dp;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  overflow: hidden;
  font-size: 9dp;
}

.equip-slot.empty {
  color: #3d2010;
  font-weight: bold;
  font-size: 7dp;
}

.equip-slot.filled {
  color: #dcc878;
  font-size: 9dp;
}

.equip-slot:hover {
  border-color: #ff981f;
}

.equip-spacer {
  width: 56dp;
  height: 56dp;
}

/* ---- Chat Panel ---- */

#chat-container {
  position: fixed;
  left: 12dp;
  bottom: 12dp;
  width: 420dp;
  height: 180dp;
  background-color: rgba(0, 0, 0, 0.55);
  border-width: 1dp;
  border-color: rgba(92, 58, 30, 0.70);
  border-radius: 4dp;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

#chat-messages {
  flex: 1;
  overflow-y: auto;
  padding: 6dp 8dp 4dp 8dp;
}

.chat-msg {
  margin-bottom: 2dp;
  font-size: 12dp;
  font-weight: bold;
}

.chat-msg.system {
  color: #ffe066;
}

.chat-msg.player {
  color: #ffffff;
}

#chat-input-bar {
  border-top-width: 1dp;
  border-top-color: rgba(255, 255, 255, 0.15);
  padding: 4dp 8dp;
  flex-shrink: 0;
}

#chat-input {
  width: 100%;
  padding: 4dp 6dp;
  background-color: rgba(0, 0, 0, 0.40);
  border-width: 1dp;
  border-color: rgba(61, 32, 16, 0.50);
  border-radius: 2dp;
  color: #ffffff;
  font-size: 12dp;
}

#chat-input:focus {
  border-color: #ff981f;
}

/* ---- Bank Panel ---- */

/* Bank panel centred via calc() since RmlUi does not support transform. */
#bank-overlay {
  display: none;
}

#bank-panel {
  position: absolute;
  left: calc(50% - 200dp);
  top: 50dp;
  width: 400dp;
  background-color: rgba(10, 4, 0, 0.95);
  border-width: 1dp;
  border-color: #8b6c3e;
  border-radius: 4dp;
  padding: 12dp;
  overflow-y: auto;
  max-height: 500dp;
}

#bank-header {
  display: flex;
  flex-direction: row;
  gap: 8dp;
  margin-bottom: 8dp;
  padding-bottom: 6dp;
  border-bottom-width: 1dp;
  border-bottom-color: rgba(61, 32, 16, 0.60);
}

.bank-btn {
  padding: 4dp 10dp;
  background-color: #3d2010;
  border-width: 1dp;
  border-color: #8b6c3e;
  border-radius: 2dp;
  color: #ff981f;
  font-size: 11dp;
  font-weight: bold;
}

.bank-btn:hover {
  background-color: #5a3020;
}

#bank-grid {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: 3dp;
}

.bank-slot {
  width: 44dp;
  height: 44dp;
  background-color: rgba(13, 6, 0, 0.70);
  border-width: 1dp;
  border-color: rgba(61, 32, 16, 0.55);
  border-radius: 2dp;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  position: relative;
}

.bank-slot:hover {
  border-color: #ff981f;
}

.bank-slot.filled {
  background-color: rgba(26, 13, 0, 0.85);
}

.bank-slot .item-name {
  font-size: 8dp;
  color: #dcc878;
  text-align: center;
  overflow: hidden;
}

.bank-slot .item-qty {
  position: absolute;
  bottom: 1dp;
  right: 2dp;
  font-size: 7dp;
  font-weight: bold;
  color: #ffdd44;
}
