{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "name": "osrs-prototype-client",
  "version-string": "0.1.0",
  "description": "Native OpenGL client for the OSRS-inspired MMO prototype",
  "builtin-baseline": "e0b785fa42e9b3ee27f62e54f65e41358a1d2671",
  "dependencies": [
    "glfw3",
    {
      "name": "glad",
      "default-features": false,
      "features": ["gl-api-46"]
    },
    "glm",
    "glaze",
    "ixwebsocket",
    "cgltf",
    "miniaudio",
    "stb",
    {
      "name": "imgui",
      "features": ["glfw-binding", "opengl3-binding", "docking-experimental"]
    }
  ]
}
